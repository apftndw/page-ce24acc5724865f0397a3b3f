g:18px 18px}\n.plan .side h4{margin:0 0 8px;font-size:13px;letter-spacing:.18em;text-transform:uppercase;color:#2b1d12}\n.plan .side p{margin:0;font-size:13.5px;color:#2b1d12}\n.plan .side p + p{margin-top:6px}\n\n/* CLIENTS */\n.clients{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}\n.client{background:#faf4ea;border-radius:18px;padding:22px 20px;box-shadow:0 12px 24px -18px rgba(43,29,18,.3)}\n.client h3{margin:0 0 6px;font-size:16px}\n.client .os{font-size:12px;letter-spacing:.18em;color:#7a5a3e;text-transform:uppercase;margin-bottom:10px}\n.client p{font-size:13.5px;color:#4a3624;margin:0 0 8px}\n.client .hint{font-size:12px;color:#6a5238}\n\n/* NODE LIST */\n.nodes{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\n.node{background:#faf4ea;border-radius:18px;padding:22px;box-shadow:0 12px 24px -18px rgba(43,29,18,.3);border-left:6px solid #b4dec8}\n.node h3{margin:0 0 6px;font-size:16px}\n.node .region{font-size:12px;letter-spacing:.18em;color:#7a5a3e;text-transform:uppercase;margin-bottom:10px}\n.node p{margin:0;font-size:13.5px;color:#4a3624}\n.node .stat{margin-top:12px;display:flex;gap:10px;font-size:12px;color:#5a4530}\n.node .stat span{background:rgba(180,222,200,.4);padding:3px 8px;border-radius:6px}\n\n/* FAQ */\n.faq{display:grid;grid-template-columns:1fr;gap:14px;max-width:880px}\n.faq details{background:#faf4ea;border-radius:18px;padding:18px 22px;box-shadow:0 10px 22px -18px rgba(43,29,18,.3)}\n.faq summary{cursor:pointer;font-size:15.5px;font-weight:600;color:#2b1d12;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px}\n.faq summary::-webkit-details-marker{display:none}\n.faq summary::after{content:\"+\";font-size:20px;color:#7a5a3e;transition:transform .2s}\n.faq details[open] summary::after{content:\"–\"}\n.faq details p{margin:14px 0 0;font-size:14px;color:#4a3624}\n\n/* FOOTER */\nfooter{padding:40px 0 60px;font-size:13px;color:#6a5238}\nfooter .row{display:flex;flex-wrap:wrap;gap:18px;justify-content:space-between;align-items:center}\nfooter .links a{margin-right:14px}\n\n/* RESPONSIVE */\n@media (max-width: 880px){h1{font-size:38px}\n.hero{grid-template-columns:1fr;gap:28px;padding:32px 0 40px}\n.use-grid,.nodes{grid-template-columns:1fr 1fr}\n.clients{grid-template-columns:1fr 1fr}\n.plan{grid-template-columns:1fr}}\n@media (max-width: 520px){\n.wrap{padding:0 18px}\nh1{font-size:32px}\n.lede{font-size:16px}\n.use-grid,.nodes,.clients{grid-template-columns:1fr}\n.info-panel{padding:24px 20px}\n.anchor-bar{font-size:12px}\nsection{padding:44px 0}\nh2{font-size:24px}\n}\n</style><main>\n<div class=\"wrap\">\n\n<nav class=\"anchor-bar\" aria-label=\"页内导航\">\n<a href=\"#intro\">服务概览</a>\n<a href=\"#use\">使用步骤</a>\n<a href=\"#plans\">订阅方案</a>\n<a href=\"#clients\">客户端适配</a>\n<a href=\"#nodes\">节点与线路</a>\n<a href=\"#faq\">常见问题</a>\n</nav>\n\n\n<header class=\"hero\" id=\"intro\">\n<div>\n<p class=\"eyebrow\">GFWAirPort · 翻墙机场</p>\n<h1>翻墙机场(GFWAirPort) · 翻墙机场<br>把节点订阅交给一张干净的清单。</h1>\n<p class=\"lede\">GFWAirPort 是一个面向个人与团队的节点订阅服务。我们不堆术语，只把流量、设备数、线路类型写明白，让你在订阅前就能算清楚每月账单。</p>\n<p class=\"tight\">打开后台，复制订阅链接，粘贴到任意支持导入的客户端即可使用。节点按地区与线路类型分组，客户端可一键切换。</p>\n<p class=\"tight\">套餐按月与按年两种周期提供，续费可随时在账户中心操作。</p>\n<div class=\"meta\">\n<span>三档订阅</span>\n<span>支持多设备</span>\n<span>年付优惠</span>\n<span>工单与邮件支持</span>\n</div>\n</div>\n<aside class=\"info-panel\" aria-label=\"服务速览\">\n<h3>服务速览</h3>\n<dl>\n<dt>服务类型</dt><dd>节点订阅</dd>\n<dt>订阅周期</dt><dd>月付 / 年付</dd>\n<dt>设备上限</dt><dd>按套餐 3 – 20 台</dd>\n<dt>线路类型</dt><dd>普通线路 · IPLC 专线</dd>\n<dt>计费方式</dt><dd>按套餐固定流量</dd>\n<dt>支持客户端</dt><dd>主流代理工具</dd>\n</dl>\n<span class=\"pill\">后台开通 · 立即可用</span>\n</aside>\n</header>\n\n\n<section id=\"use\">\n<h2>三步开始使用</h2>\n<p class=\"section-sub\">从下单到连接的过程被拆成最小步骤，每一步都对应一个具体动作。</p>\n<div class=\"use-grid\">\n<article class=\"use-card\">\n<span class=\"num\">STEP 01</span>\n<h3>选择订阅方案</h3>\n<p>在下方三档套餐中按设备数与流量需求选择，确认月付或年付。</p>\n<ul>\n<li>个人使用建议基础版</li>\n<li>多设备与流媒体建议旗舰版</li>\n<li>团队与高并发建议团队版</li>\n</ul>\n</article>\n<article class=\"use-card\">\n<span class=\"num\">STEP 02</span>\n<h3>获取订阅链接</h3>\n<p>下单完成后在账户中心复制订阅地址，链接包含一串识别码。</p>\n<ul>\n<li>链接请勿公开转发</li>\n<li>支持一键重置</li>\n<li>可在后台查看到期日</li>\n</ul>\n</article>\n<article class=\"use-card\">\n<span class=\"num\">STEP 03</span>\n<h3>导入客户端并连接</h3>\n<p>在客户端的订阅设置中粘贴链接，同步节点列表后选择线路即可。</p>\n<ul>\n<li>支持手动添加单节点</li>\n<li>可按延迟排序</li>\n<li>支持分节点测速</li>\n</ul>\n</article>\n</div>\n</section>\n\n\n<section id=\"plans\">\n<h2>订阅方案</h2>\n<p class=\"section-sub\">三档按设备数与流量划分，年付较月付合计减免两个月费用，页面所列为参考价格，实际以下单页为准。</p>\n<div class=\"plans\">\n<article class=\"plan\">\n<div>\n<h3>基础版</h3>\n<p class=\"price\">¥15 / 月</p>\n<p class=\"annual\">按年付仅需 ¥150 / 年</p>\n<ul>\n<li>每月 100GB 流量</li>\n<li>支持 3 台设备同时在线</li>\n<li>解锁基础流媒体</li>\n<li>普通线路节点池</li>\n</ul>\n</div>\n<div class=\"side\">\n<h4>适合谁</h4>\n<p>个人轻度使用，1 – 2 台设备日常浏览与看视频。</p>\n<p>流量用尽后当月不再下发新订阅，次月 1 日恢复。</p>\n</div>\n</article>\n\n<article class=\"plan featured\">\n<span class=\"tag\">推荐</span>\n<div>\n<h3>旗舰版</h3>\n<p class=\"price\">¥35 / 月</p>\n<p class=\"annual\">按年付仅需 ¥350 / 年</p>\n<ul>\n<li>每月 300GB 流量</li>\n<li>支持 5 台设备同时在线</li>\n<li>全节点原生流媒体解锁</li>\n<li>IPLC 专线游戏加速优化</li>\n<li>7×24 优先工单支持</li>\n</ul>\n</div>\n<div class=\"side\">\n<h4>适合谁</h4>\n<p>家庭或重度用户，多设备同时在线，关注流媒体与游戏延迟。</p>\n<p>优先队列处理工单，平均响应时间较基础版更短。</p>\n</div>\n</article>\n\n<article class=\"plan\">\n<div>\n<h3>团队版</h3>\n<p class=\"price\">¥85 / 月</p>\n<p class=\"annual\">按年付仅需 ¥850 / 年</p>\n<ul>\n<li>每月 1000GB 流量</li>\n<li>支持 20 台设备同时在线</li>\n<li>VIP 专属高带宽节点</li>\n<li>支持企业定制路由</li>\n<li>专属客户经理服务</li>\n</ul>\n</div>\n<div class=\"side\">\n<h4>适合谁</h4>\n<p>工作室、小型团队或多设备办公场景，需要统一管理与高带宽。</p>\n<p>可联系客户经理调整节点分配与流量上限。</p>\n</div>\n</article>\n</div>\n</section>\n\n\n<section id=\"clients\">\n<h2>客户端适配</h2>\n<p class=\"section-sub\">服务以标准订阅链接形式下发，兼容以下常见代理客户端。具体设置步骤请参见各客户端官方文档。</p>\n<div class=\"clients\">\n<article class=\"client\">\n<span class=\"os\">Windows</span>\n<h3>桌面代理工具</h3>\n<p>支持系统托盘运行，导入订阅链接后自动同步节点列表。</p>\n<p class=\"hint\">系统：Windows 10 及以上</p>\n</article>\n<article class=\"client\">\n<span class=\"os\">macOS</span>\n<h3>桌面代理工具</h3>\n<p>支持菜单栏快速切换节点，可按延迟排序自动选择。</p>\n<p class=\"hint\">系统：macOS 11 及以上</p>\n</article>\n<article class=\"client\">\n<span class=\"os\">iOS / iPadOS</span>\n<h3>移动代理工具</h3>\n<p>通过应用内订阅导入功能粘贴链接，配置完成后按需开启。</p>\n<p class=\"hint\">需在系统设置中允许 VPN 配置</p>\n</article>\n<article class=\"client\">\n<span class=\"os\">Android</span>\n<h3>移动代理工具</h3>\n<p>支持从剪贴板一键导入，支持分应用代理设置。</p>\n<p class=\"hint\">系统：Android 9 及以上</p>\n</article>\n<article class=\"client\">\n<span class=\"os\">Linux</span>\n<h3>命令行 / GUI</h3>\n<p>支持订阅链接命令行导入，亦可使用图形界面客户端。</p>\n<p class=\"hint\">常见发行版均可用</p>\n</article>\n<article class=\"client\">\n<span class=\"os\">路由器</span>\n<h3>OpenWrt / 梅林</h3>\n<p>支持在路由器后台配置全局代理，覆盖局域网所有设备。</p>\n<p class=\"hint\">需刷入支持插件的固件</p>\n</article>\n<article class=\"client\">\n<span class=\"os\">Apple TV</span>\n<h3>电视端代理</h3>\n<p>通过配置文件方式导入，客厅设备可统一走代理。</p>\n<p class=\"hint\">需配合路由器或网关使用</p>\n</article>\n<article class=\"client\">\n<span class=\"os\">通用</span>\n<h3>自定义导入</h3>\n<p>任意支持标准订阅协议的客户端均可使用，节点信息以订阅内容为准。</p>\n<p class=\"hint\">订阅格式请参考帮助中心</p>\n</article>\n</div>\n</section>\n\n\n<section id=\"nodes\">\n<h2>节点与线路</h2>\n<p class=\"section-sub\">节点按地区与线路类型分组，订阅导入后可在客户端内按延迟或用途选择。线路类型说明请见下方分组。</p>\n<div class=\"nodes\">\n<article class=\"node\">\n<span class=\"region\">亚太</span>\n<h3>常用地区入口</h3>\n<p>覆盖港澳台、日韩、新马泰等周边地区，适合低延迟日常使用。</p>\n<div class=\"stat\"><span>低延迟</span><span>日常浏览</span></div>\n</article>\n<article class=\"node\">\n<span class=\"region\">欧美</span>\n<h3>跨海地区入口</h3>\n<p>覆盖美西、美东、英德法等地区，适合跨境业务与流媒体。</p>\n<div class=\"stat\"><span>大带宽</span><span>流媒体</span></div>\n</article>\n<article class=\"node\">\n<span class=\"region\">专线</span>\n<h3>IPLC 专线</h3>\n<p>专线通道，波动更小，适合游戏加速、远程办公等对稳定敏感的用途。</p>\n<div class=\"stat\"><span>波动小</span><span>游戏 / 办公</span></div>\n</article>\n</div>\n</section>\n\n\n<section id=\"faq\">\n<h2>常见问题</h2>\n<p class=\"section-sub\">下单、订阅、使用过程中最常被问到的问题，按主题整理如下。</p>\n<div class=\"faq\">\n\n<details>\n<summary>订阅链接会在哪里看到？</summary>\n<p>下单完成后，登录账户中心即可在「我的订阅」页面看到订阅链接与到期时间。链接为个人凭证，请勿在公开群组转发。</p>\n</details>\n\n<details>\n<summary>流量用完之后还能继续用吗？</summary>\n<p>当月流量用尽后，当月订阅不再下发新流量。次月 1 日 0 点起，订阅自动恢复并按套餐重新计费，不会累计到下一月。</p>\n</details>\n\n<details>\n<summary>支持多少台设备同时在线？</summary>\n<p>基础版最多 3 台，旗舰版最多 5 台，团队版最多 20 台。设备数以同时建立有效连接的数量计算。</p>\n</details>\n\n<details>\n<summary>可以中途升级或降级套餐吗？</summary>\n<p>可以在账户中心提交变更申请，差价按剩余天数折算。降级在当前订阅周期结束后生效，升级可立即生效。</p>\n</details>\n\n<details>\n<summary>订阅链接泄露了怎么办？</summary>\n<p>请在账户中心使用「重置订阅」功能，重置后旧链接立即失效，新链接会同步显示。</p>\n</details>\n\n<details>\n<summary>支持哪些支付方式？</summary>\n<p>支持常见线上支付方式，具体以下单页面显示的支付渠道为准。企业付款可联系客户经理。</p>\n</details>\n\n<details>\n<summary>年付和月付可以同时存在吗？</summary>\n<p>同一账户同一时段只生效一个套餐。如已有月付订阅，可在该周期结束前购买年付，年付将在月付到期后自动衔接。</p>\n</details>\n\n<details>\n<summary>如何选择节点与线路？</summary>\n<p>日常浏览选择延迟最低的节点即可；对稳定性要求高的场景（如游戏、远程办公）建议选择 IPLC 专线节点。</p>\n</details>\n\n<details>\n<summary>可以申请发票吗？</summary>\n<p>团队版及以上套餐支持开具发票，下单时备注开票信息即可。基础版与旗舰版如需发票，请联系客服确认。</p>\n</details>\n\n</div>\n</section>\n\n</div>\n</main>\n\n<footer>\n<div class=\"wrap\">\n<div class=\"row\">\n<div>© GFWAirPort · 翻墙机场</div>\n<div class=\"links\">\n<a href=\"#intro\">回到顶部</a>\n<a href=\"#plans\">订阅方案</a>\n<a href=\"#faq\">常见问题</a>\n</div>\n</div>\n</div>\n</footer>",
